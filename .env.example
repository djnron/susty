ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Adds Gemini to the model picker's provider list — only shown once
# this is set. Get one at https://aistudio.google.com/apikey
# GOOGLE_GEMINI_API_KEY=your-gemini-key-here

# optional, defaults to claude-sonnet-5-5. Overrides the Sonnet tier (also the
# server's fallback tier) only; the picker still labels it "Sonnet 5.5";
# it deliberately does not override the other tiers in api/chat.js. The
# thinking settings sent follow the model named here (minimalThinking() in
# api/chat.js), which handles the current Claude ids, the 4.x ones and dated
# ids; a model it does not know gets no thinking setting at all.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional off switches for the ledger's model and thinking pickers. Both default to on.
#   SUSTY_EXPENSIVE_TIERS=off  runs the Medium and High thinking levels at Least
#   SUSTY_TIERS=off            collapses every request to the fallback tier (Sonnet 5.5)
# The client default is Opus 5.5 at Medium (up to 4,000 output tokens, about
# $0.08 a reply); with SUSTY_EXPENSIVE_TIERS=off it runs Opus at Least.
# Medium and High thinking can spend several times a normal exchange on your
# own key (High on Opus: up to 8,000 output tokens, about $0.16 a reply),
# against a rate limit that resets on cold start. Turn them off before going
# public unless you want to pay for them. Opus also thinks a little at Least
# (Opus 5.5 cannot switch it off), within a 2,000-token ceiling;
# SUSTY_EXPENSIVE_TIERS=off does not touch that, SUSTY_TIERS=off does.
# SUSTY_EXPENSIVE_TIERS=off

# Optional. Switches US visitors from eGRID annual averages to hourly
# readings derived from the EIA-930 generation mix. Free key, instant signup:
# https://www.eia.gov/opendata/register.php
# Without it the app falls back to eGRID and says so in the ledger.
# EIA_API_KEY=your-eia-key-here

# Optional. Live intensity for other countries. Absolute values need a paid
# Electricity Maps plan; the free tier returns only high/moderate/low, which
# a meter can't use. Great Britain needs no key at all (NESO is open).
# ELECTRICITY_MAPS_TOKEN=your-token-here
