ANTHROPIC_API_KEY=sk-ant-your-key-here
# optional, defaults to claude-sonnet-4-6. Overrides the default tier only;
# it deliberately does not override the other tiers in api/chat.js.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional off switches for the ledger's model picker. Both default to on.
#   SUSTY_EXPENSIVE_TIERS=off  drops the extended-thinking tier from the menu
#   SUSTY_TIERS=off            collapses every request to the default tier
# The thinking tier spends several times a normal exchange on your own key,
# against a rate limit that resets on cold start. Turn it off before going
# public unless you want to pay for it.
# SUSTY_EXPENSIVE_TIERS=off

# Optional. Switches US visitors from eGRID annual averages to hourly
# readings derived from the EIA-930 generation mix. Free key, instant signup:
# https://www.eia.gov/opendata/register.php
# Without it the app falls back to eGRID and says so in the ledger.
# EIA_API_KEY=your-eia-key-here

# Optional. Live intensity for other countries. Absolute values need a paid
# Electricity Maps plan; the free tier returns only high/moderate/low, which
# a meter can't use. Great Britain needs no key at all (NESO is open).
# ELECTRICITY_MAPS_TOKEN=your-token-here
